# Argos local rules — start few to avoid noise.

# SSH brute-force style threshold (example)
alert tcp any any -> $HOME_NET 22 (msg:"ARGOS SSH many connections"; \
  flags:S; threshold: type both, track by_src, count 20, seconds 60; \
  classtype:attempted-admin; sid:9000001; rev:1;)

# Port scan style threshold
alert tcp any any -> $HOME_NET any (msg:"ARGOS possible port scan"; \
  flags:S; threshold: type both, track by_src, count 30, seconds 30; \
  classtype:attempted-recon; sid:9000002; rev:1;)
