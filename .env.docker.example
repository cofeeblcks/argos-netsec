# Copy to .env at repo root for Docker Compose:
#   cp .env.docker.example .env
# See deploy/env.md for Telegram and sensor details.

# --- MariaDB (lab fallbacks — change for shared/lab hosts) ---
# Compose publishes DB on host 127.0.0.1:3307 (avoids clash with host MariaDB :3306)
MARIADB_DATABASE=argos_netsec
MARIADB_USER=argos
MARIADB_PASSWORD=argos
MARIADB_ROOT_PASSWORD=argos_root

# --- Laravel API ---
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
# 32-byte lab key (replace for anything beyond local Docker)
APP_KEY=base64:QXJnb3NOZXRTZWNEb2NrZXJMYWJLZXkzMkJ5dGVzISE=
RUN_SEED=1

# --- Reverb (browser must use 127.0.0.1, not localhost) ---
REVERB_APP_ID=argos-local
REVERB_APP_KEY=argos-reverb-key
REVERB_APP_SECRET=argos-reverb-secret
REVERB_HOST=127.0.0.1
# API/queue → Reverb inside Compose (service name)
REVERB_BROADCAST_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# --- Dashboard (Vite) ---
VITE_API_URL=http://127.0.0.1:8000
VITE_REVERB_HOST=127.0.0.1
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
VITE_DEMO=false

# --- Telegram (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MIN_SEVERITY=high
TELEGRAM_DEDUPE_MINUTES=15
ARGOS_ALERT_RETENTION_DAYS=30

# --- Sensors (docker compose --profile sensors) ---
ARGOS_API_URL=http://127.0.0.1:8000
SCANNER_TOKEN=scanner-dev-token
IDS_TOKEN=ids-dev-token
ARGOS_IFACE=enp4s0
ARGOS_NETWORK_CIDR=
ARGOS_DISCOVERY_MINUTES=5
ARGOS_NMAP_TIMING=-T3
ARGOS_AUTHORIZED_REFRESH=true
# Keep false unless you intentionally enable Scapy ARP sniff (needs caps)
ARGOS_ENABLE_ARP_SPOOF=false
